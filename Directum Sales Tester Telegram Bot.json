    {
      "parameters": {
        "jsCode": "// Самый надежный способ для n8n Aggregate\nconst inputItem = $input.first();\nlet items = [];\n\n// Проверяем все возможные места где может быть массив\nif (inputItem.json && Array.isArray(inputItem.json)) {\n  items = inputItem.json;\n} else if (inputItem.json && inputItem.json.data && Array.isArray(inputItem.json.data)) {\n  items = inputItem.json.data;\n} else {\n  items = [];\n}\n\nconst messageLines = items.map(item => `${item.id}. ${item.name}. /theme${item.id}`);\nconst telegramMessage = messageLines.join('\\n\\n') || 'Список пуст';\n\nreturn [{\n  json: {\n    message: telegramMessage,\n    parse_mode: 'HTML'\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1360,
        608
      ],
      "id": "406c88bb-7135-46e7-94b6-488762b5c0c8",
      "name": "Список тем"
    },
    {
      "parameters": {
        "jsCode": "// Берем массив тем из блока \"Все темы\" → поле data\nconst themesData = $node[\"Все темы1\"].json.data || [];\n\n// Извлекаем только цифры из сообщения пользователя\nconst userNumber = $('Номер темы').first().json.theme\n\n// Проверяем условия\nif (!userNumber || themesData.length === 0) {\n  return [{\n    json: {\n      isValid: false,\n      error: \"Введите номер темы (только цифру)\",\n      validIds: themesData.map(t => t.id)\n    }\n  }];\n}\n\n// Проверяем что номер существует в списке тем\nconst themeId = parseInt(userNumber);\nconst selectedTheme = themesData.find(theme => parseInt(theme.id) === themeId);\n\nif (!selectedTheme) {\n  return [{\n    json: {\n      isValid: false,\n      error: `Темы с номером ${userNumber} не существует`,\n      validIds: themesData.map(t => t.id)\n    }\n  }];\n}\n\n// ✅ Валидный номер\nreturn [{\n  json: {\n    isValid: true,\n    themeId: themeId,\n    themeName: selectedTheme.name,\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1744,
        800
      ],
