      "parameters": {
        "jsCode": "// Забираем текст из первого элемента выхода узла \"AI Agent\"\nconst text = $('Result Message').first().json.text || '';\n\n// Режем регуляркой по 4000 любых символов (включая пробелы и переносы)\n// Если текст пустой, вернет пустой массив (или можно оставить один пустой объект)\nconst chunks = text.match(/[\\s\\S]{1,4000}/g) || [text];\n\n// Возвращаем в формате, который ждет n8n\nreturn chunks.map(chunk => ({\n  json: { \n    text: chunk \n  }\n}));\n"
